# Harness environment variables
# Copy this file to .env and fill in real values. .env is ignored by Git.

# API key for the selected OpenAI-compatible provider.
HARNESS_API_KEY=your-api-key-here

# OpenAI example
HARNESS_LLM_PROVIDER=openai
HARNESS_LLM_MODEL=gpt-4o-mini
HARNESS_LLM_BASE_URL=https://api.openai.com/v1

# DeepSeek example
# HARNESS_LLM_PROVIDER=deepseek
# HARNESS_LLM_MODEL=deepseek-chat
# HARNESS_LLM_BASE_URL=https://api.deepseek.com/v1
